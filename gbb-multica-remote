#!/usr/bin/env python3
"""Reply router. Routes select a local endpoint or a fixed SSH connection."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

SAFE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,79}')


def ssh_base(route):
    alias = route.get('ssh_alias')
    if not isinstance(alias, str) or not SAFE_NAME.fullmatch(alias):
        raise ValueError('invalid ssh_alias')
    command = ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10']
    config = route.get('ssh_config')
    if config is not None:
        if not isinstance(config, str) or not config.startswith('/') or any(c in config for c in '\n\r\0'):
            raise ValueError('invalid ssh_config path')
        command += ['-F', config]
    return [*command, '--', alias]


def endpoint_args(route, action, message_id=None):
    if not isinstance(route.get('instance_id'), str) or not SAFE_NAME.fullmatch(route['instance_id']):
        raise ValueError('invalid instance_id')
    endpoint = route.get('endpoint', '')
    if not isinstance(endpoint, str) or not endpoint.startswith('/') or any(c in endpoint for c in '\n\r\0'):
        raise ValueError('endpoint must be an absolute path')
    if action not in ('check', 'inbox', 'answer'):
        raise ValueError('unsupported action')
    if message_id is not None and not re.fullmatch(r'm[A-Za-z0-9_-]{1,127}', message_id):
        raise ValueError('invalid message ID')
    remote = [endpoint, '--instance-id', route['instance_id'], action]
    if message_id:
        remote.append(message_id)
    if action == 'answer':
        if not message_id:
            raise ValueError('answer requires message ID')
        remote.append('-')
    return remote


def ssh_command(route, action, message_id=None):
    return [*ssh_base(route), shlex.join(endpoint_args(route, action, message_id))]


def route_command(route, action, message_id=None):
    transport = route.get('transport', 'ssh')  # Existing routes remain compatible.
    if transport == 'local':
        return endpoint_args(route, action, message_id)
    if transport == 'ssh':
        return ssh_command(route, action, message_id)
    raise ValueError('unsupported transport')


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('action', choices=('check', 'inbox', 'answer'))
    parser.add_argument('route')
    parser.add_argument('message_id', nargs='?')
    parser.add_argument('stdin_marker', nargs='?', choices=('-',))
    args = parser.parse_args()
    if not SAFE_NAME.fullmatch(args.route):
        parser.error('invalid route name')
    if args.action == 'answer' and (not args.message_id or args.stdin_marker != '-'):
        parser.error('answer requires ROUTE MESSAGE_ID -; paste the answer on stdin')
    if args.action == 'check' and (args.message_id or args.stdin_marker):
        parser.error('check accepts only ROUTE')
    if args.action != 'answer' and args.stdin_marker:
        parser.error('stdin is only supported by answer')
    root = Path(os.environ.get('GBB_MULTICA_CONFIG_HOME', str(Path.home() / '.config/gbb-multica')))
    config = json.loads((root / 'routes.json').read_text())
    route = config['routes'].get(args.route)
    if not route:
        parser.error('unknown route; configure it with install.sh reply first')
    # No local shell, no credentials in argv, no automatic retry on failure.
    return subprocess.run(route_command(route, args.action, args.message_id), timeout=45).returncode


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        print('GBB reply failed; inspect the original message before retrying', file=sys.stderr)
        raise SystemExit(1)
